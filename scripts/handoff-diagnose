#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/_handoff_lib.sh
source "$SCRIPT_DIR/_handoff_lib.sh"
require_db

sqlite3 "$HANDOFF_DB" "SELECT 1 FROM handoffs LIMIT 1;" >/dev/null
sqlite3 "$HANDOFF_DB" "SELECT 1 FROM archive_handoffs LIMIT 1;" >/dev/null
echo "OK Agent Handoffs store is ready"
echo "DB: $HANDOFF_DB"
